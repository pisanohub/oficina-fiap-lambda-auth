aws_region = "us-east-1"
aws_profile = "oficina-lab"

lambda_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",
  "subnet-yyyyyyyyyyyyyyyyy"
]

lambda_security_group_id = "sg-xxxxxxxxxxxxxxxxx"

db_host     = "oficina-fiap-db.example.us-east-1.rds.amazonaws.com"
db_port     = 5432
db_name     = "oficina"
db_username = "oficinaadmin"
db_password = "NAO_VERSIONAR_A_SENHA_REAL"

# Contrato com o time da aplicacao/Kubernetes. Deve ser uma URL alcancavel
# pelo API Gateway, sem o caminho /api no final.
app_base_url = "https://api.exemplo.com"

environment = "dev"

# jwt_secret e obrigatorio: forneca via TF_VAR_jwt_secret no ambiente local.
# No GitHub Actions, use o Secret JWT_SECRET. Nunca versionar o valor real.
